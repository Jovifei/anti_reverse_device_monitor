{
  "name": "anti-reverse-device-monitor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "tsx scripts/prisma-push.ts",
    "import:excel": "tsx scripts/import-excel.ts",
    "cleanup": "tsx scripts/cleanup-retention.ts",
    "verify-data": "tsx scripts/verify-data.ts",
    "source:inspect": "tsx scripts/inspect-source.ts",
    "source:validate-mapping": "tsx scripts/validate-source-mapping.ts",
    "db:ensure-migrations": "node --env-file=.env.local scripts/ensure-db-migrations.mjs",
    "source:sync": "node --max-old-space-size=4096 ./node_modules/tsx/dist/cli.mjs scripts/sync-source-data.ts",
    "source:worker": "node --max-old-space-size=4096 ./node_modules/tsx/dist/cli.mjs scripts/source-sync-worker.ts",
    "devices:sync-registry": "tsx scripts/sync-device-registry.ts",
    "inspect:mongodb": "tsx scripts/inspect-mongodb-source.ts",
    "demo:seed": "tsx scripts/seed-demo.ts",
    "demo": "tsx scripts/start-demo.ts",
    "ui:capture": "tsx scripts/capture-ui-review.ts",
    "export:html": "tsx scripts/export-offline-html.ts",
    "export:html:demo": "tsx scripts/export-offline-html.ts --demo --all --bundle --single-file",
    "export:html:excel": "tsx scripts/export-offline-html.ts --excel",
    "export:html:four-device-review": "tsx scripts/rebuild-offline-review-from-static.ts",
    "refresh:offline-html-snapshots": "tsx scripts/refresh-offline-html-snapshots.ts",
    "verify:offline-review-charts": "tsx scripts/verify-offline-review-charts.ts",
    "test:unit": "vitest run tests/unit",
    "test:integration": "tsx tests/integration/run.ts",
    "test:e2e:seed": "tsx tests/e2e/seed.ts",
    "test:e2e": "npm run test:e2e:seed && tsx tests/e2e/run.ts",
    "test:offline-html": "tsx tests/e2e/run-offline-html.ts",
    "test": "npm run test:unit && npm run test:integration"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "axios": "^1.8.4",
    "echarts": "^6.1.0",
    "mongodb": "^7.5.0",
    "next": "^15.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.1",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.4.47",
    "prisma": "^5.20.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  }
}
