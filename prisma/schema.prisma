generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("APP_DATABASE_URL")
}

model Device {
  id                  Int                 @id @default(autoincrement())
  deviceSn            String              @unique
  productModel        String?
  macAddress          String?
  softwareVersion     String?
  hardwareVersion     String?
  productConfig       String?
  sub1gVersion        String?
  sub1gAddress        String?
  lastReportedAt      DateTime?
  platformOnline      Boolean             @default(false)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  inverterBindings    InverterBinding[]
  telemetry           Telemetry[]
  latestRows          DeviceLatest[]
  events              DeviceEvent[]
  reverseFlowAlerts   ReverseFlowAlert[]
}

model InverterBinding {
  id                Int      @id @default(autoincrement())
  deviceId          Int
  inverterIndex     Int
  inverterSn        String?
  productModel      String?
  softwareVersion   String?
  hardwareVersion   String?
  sub1gVersion     String?
  phaseNum         String?
  connectionPoint   String?
  paired           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  device           Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  telemetry        Telemetry[]
  latestRows       DeviceLatest[]
  events          DeviceEvent[]
  faultEvents     FaultEvent[]

  @@unique([deviceId, inverterIndex])
  @@unique([deviceId, inverterSn])
}

model MetricDefinition {
  id              Int      @id @default(autoincrement())
  metricKey       String   @unique
  siid            String
  piid            String
  identifier      String
  displayName     String
  dataKind        String
  valueType       String
  unit            String?
  chartGroup      String?
  chartEnabled    Boolean  @default(true)
  enumSource      String?
  enumJson        String?
  warningMin      Float?
  warningMax      Float?
  criticalMin     Float?
  criticalMax     Float?
  retentionDays   Int?
}

model Telemetry {
  id              Int      @id @default(autoincrement())
  deviceId        Int
  inverterId      Int?
  siid            String
  piid            String
  metricKey       String
  reportedAt      DateTime
  receivedAt      DateTime @default(now())
  valueNumber     Float?
  valueText       String?
  sourceRecordId  String   @unique
  sourceName      String   @default("excel")

  device          Device          @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  inverterBinding InverterBinding? @relation(fields: [inverterId], references: [id], onDelete: SetNull)

  @@index([deviceId, metricKey, reportedAt(sort: Desc)])
  @@index([inverterId, metricKey, reportedAt(sort: Desc)])
  @@index([sourceName, reportedAt])
  @@index([deviceId, inverterId, metricKey, reportedAt, sourceRecordId])
}

model DeviceLatest {
  id           Int      @id @default(autoincrement())
  deviceId     Int
  inverterId   Int?
  metricKey    String
  valueNumber  Float?
  valueText    String?
  reportedAt   DateTime
  receivedAt   DateTime

  device       Device          @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  inverter     InverterBinding? @relation(fields: [inverterId], references: [id], onDelete: SetNull)

  @@unique([deviceId, inverterId, metricKey], name: "deviceId_inverterId_metricKey")
  @@index([deviceId, metricKey])
}

model DeviceEvent {
  id          Int      @id @default(autoincrement())
  deviceId    Int
  inverterId  Int?
  eventType   String
  fromState   String?
  toState     String?
  happenedAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  device      Device          @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  inverter    InverterBinding? @relation(fields: [inverterId], references: [id], onDelete: SetNull)

  @@index([deviceId, happenedAt])
}

model FaultEvent {
  id               Int      @id @default(autoincrement())
  inverterId       Int
  faultMask        Int
  faultHex         String
  activeFaultsJson  String
  eventType        String
  startedAt        DateTime
  endedAt          DateTime?
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())

  inverter         InverterBinding @relation(fields: [inverterId], references: [id], onDelete: Cascade)

  @@index([inverterId, startedAt])
}

model ReverseFlowAlert {
  id             Int      @id @default(autoincrement())
  deviceId       Int
  phase          String
  startedAt      DateTime
  endedAt        DateTime?
  minimumPowerW  Float
  sampleCount    Int      @default(0)
  severity       String
  createdAt      DateTime @default(now())

  device         Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, phase, startedAt])
}

model ImportBatch {
  id           Int      @id @default(autoincrement())
  source       String
  fileName     String
  importedAt   DateTime @default(now())
  recordCount  Int      @default(0)
  checksum     String?
  status       String   @default("running")
}

model SyncCheckpoint {
  id          Int      @id @default(autoincrement())
  sourceName  String
  sourceCursor String
  syncedAt    DateTime @default(now())
  status      String   @default("ok")
  lastError   String?
  lastSuccessAt DateTime?

  @@unique([sourceName])
}

model SyncBatch {
  id                 Int         @id @default(autoincrement())
  sourceName         String
  status             String
  startedAt          DateTime    @default(now())
  completedAt        DateTime?
  cursorBefore       String?
  cursorAfter        String?
  imported           Int         @default(0)
  duplicatesSkipped  Int         @default(0)
  failed             Int         @default(0)
  unknownMetrics     Int         @default(0)
  missingIdentifiers Int         @default(0)
  lastError          String?
  errors             SyncError[]

  @@index([sourceName, startedAt])
}

model SyncError {
  id             Int       @id @default(autoincrement())
  syncBatchId    Int
  sourceRecordId String?
  errorCode      String
  message        String
  createdAt      DateTime  @default(now())
  syncBatch      SyncBatch @relation(fields: [syncBatchId], references: [id], onDelete: Cascade)

  @@index([syncBatchId])
}
