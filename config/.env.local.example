# Application
APP_ENV=development
APP_NAME=Anti-Reverse Device Monitor
APP_TIMEZONE=Asia/Shanghai

# Application database: SQLite in phase 1
APP_DATABASE_URL=file:../data/device-monitor.db

# Retention
DATA_RETENTION_DAYS=7
CLEANUP_ENABLED=true

# Import
IMPORT_DIRECTORY=./data/imports
IMPORT_TIMEZONE=Asia/Shanghai

# Source database: server-side, read-only, disabled until Phase 2 approval
SOURCE_DB_ENABLED=false
SOURCE_DB_TYPE=
SOURCE_DATABASE_URL=
SOURCE_DB_SCHEMA=
SOURCE_DB_VIEW=
SOURCE_DB_TIMEZONE=Asia/Shanghai
SOURCE_SYNC_INTERVAL_SECONDS=60
SOURCE_QUERY_TIMEOUT_SECONDS=15
SOURCE_SYNC_BATCH_SIZE=1000
SOURCE_INITIAL_LOOKBACK_DAYS=7
SOURCE_SSL_MODE=

# Public browser-safe values only
NEXT_PUBLIC_APP_NAME=防逆流设备运行可视化
