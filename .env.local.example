# Copy this file to .env.local. Do not put this file or a real connection string in browser code.
# Prisma SQLite: use socket_timeout (seconds), NOT busy_timeout — Quaint ignores busy_timeout
APP_DATABASE_URL=file:../data/device-monitor.db?socket_timeout=5&connection_limit=1
APP_TIMEZONE=Asia/Shanghai
DATA_RETENTION_DAYS=7
SOURCE_DB_ENABLED=true
SOURCE_DB_TYPE=mongodb
SOURCE_DATABASE_URL=
SOURCE_DB_SCHEMA=
SOURCE_DB_VIEW=
SOURCE_DB_TIMEZONE=Asia/Shanghai
SOURCE_QUERY_TIMEOUT_SECONDS=15
SOURCE_SYNC_INTERVAL_SECONDS=10
SOURCE_SYNC_BATCH_SIZE=1000
SOURCE_INITIAL_LOOKBACK_DAYS=7
SOURCE_SSL_MODE=

# MongoDB read-only company log source (server-side only). Never expose to the browser.
# The host/database/product/collection are project defaults; replace only the
# URL-encoded password locally and never commit the real URI.
MONGODB_URI=mongodb://zeicomongo:<PASSWORD>@proxy.zeico.cn:3718/zeico_cloud?authSource=zeico_cloud
MONGODB_DATABASE=zeico_cloud
MONGODB_COLLECTION=device_log_689adc659f04ec32f7642fbb
MONGODB_PRODUCT_ID=689adc659f04ec32f7642fbb
MONGODB_DIRECT_CONNECTION=true
MONGODB_AUTH_MECHANISM=SCRAM-SHA-1
# Optional path overrides (defaults under config/)
# DEVICES_SN_MAP_PATH=config/device-sn-map.xlsx
# DEVICES_REGISTRY_PATH=config/devices.json
# MONGO_FIELD_MAPPING_PATH=config/mongo-field-mapping.example.json

# Secret for the protected daily-sync cron endpoint.
# Consumed by POST /api/cron/sync-iot (Docker cron path) — must match the
# caller's "Authorization: Bearer <CRON_SECRET>" header.
# Missing/empty CRON_SECRET → endpoint returns 503; wrong token → 401.
# GET /api/cron/sync-iot stays unauthenticated by design (liveness probe).
CRON_SECRET=

# IoT platform connection (造梦者 / iot.iald.cn).
# Consumed by src/adapters/iot-api/iot-client.ts and scripts/analyze-iot-recency.ts.
# Missing/empty DREAM_MAKER_IOT_TOKEN → IotConfigError ("Set DREAM_MAKER_IOT_TOKEN in .env.local").
# Default baseUrl when unset: https://iot.dream-maker.com. Override DREAM_MAKER_IOT_BASE_URL
# when your tenant uses a different host (e.g. http://iot.iald.cn).
DREAM_MAKER_IOT_BASE_URL=https://iot.dream-maker.com
DREAM_MAKER_IOT_TOKEN=

# Optional productId override for `npm run devices:analyze-recency`.
# Default when unset: 6a02f379ad14f363eef24890
IOT_RECENCY_PRODUCT_ID=
