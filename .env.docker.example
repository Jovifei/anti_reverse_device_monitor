# Copy to .env.docker for compose (do not commit real secrets).
APP_TIMEZONE=Asia/Shanghai
DATA_RETENTION_DAYS=7
SOURCE_DB_ENABLED=false
SOURCE_DB_TYPE=mongodb
SOURCE_DB_VIEW=mongo-device-log
SOURCE_DB_TIMEZONE=Asia/Shanghai
SOURCE_QUERY_TIMEOUT_SECONDS=15
SOURCE_SYNC_BATCH_SIZE=1000
SOURCE_INITIAL_LOOKBACK_DAYS=7
SOURCE_SYNC_INTERVAL_SECONDS=10
MONGODB_URI=mongodb://zeicomongo:<PASSWORD>@proxy.example.com:3718/?authSource=zeico_cloud
MONGODB_DATABASE=
# Defaults to anti-reverse CT product 689adc659f04ec32f7642fbb when empty
MONGODB_PRODUCT_ID=
MONGODB_COLLECTION=
MONGODB_DIRECT_CONNECTION=true
MONGODB_AUTH_MECHANISM=SCRAM-SHA-1
